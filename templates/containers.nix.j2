{#- Converts YAML data to a Nix value: strings are quoted, with ${ escaped so
    Nix doesn't interpolate it; attribute names are quoted when needed. #}
{%- macro nix(value, indent=0) -%}
{%- if value is boolean -%}
{{ value | lower }}
{%- elif value is number -%}
{{ value }}
{%- elif value is string -%}
{{ value | to_json(ensure_ascii=false) | replace('${', '\\${') }}
{%- elif value is mapping -%}
{
{% for key in value | sort %}
{{ '  ' * (indent + 1) }}{{ key if key is match('^[A-Za-z_][A-Za-z0-9_-]*$') else key | to_json }} = {{ nix(value[key], indent + 1) }};
{% endfor %}
{{ '  ' * indent }}}
{%- else -%}
[
{% for element in value %}
{{ '  ' * (indent + 1) }}{{ nix(element, indent + 1) }}
{% endfor %}
{{ '  ' * indent }}]
{%- endif -%}
{%- endmacro -%}
{{ ansible_managed | comment }}
{ config, lib, pkgs, ... }:

{
  virtualisation.podman = {
    enable = true;
    autoPrune.enable = true;
  };

  virtualisation.oci-containers.backend = "podman";
  virtualisation.oci-containers.containers = {{ nix(nixos_containers, 1) }};

  systemd.tmpfiles.rules = [
{% for dir in nixos_container_dirs %}
{%   set dir = dir if dir is mapping else {'path': dir} %}
    "d {{ dir.path }} {{ dir.mode | default('-') }} {{ dir.owner | default('-') }} {{ dir.group | default('-') }} -"
{% endfor %}
  ];
{% for network in nixos_container_networks %}
{%   set users = nixos_containers | dict2items | selectattr('value.networks', 'defined')
                 | selectattr('value.networks', 'contains', network) | map(attribute='key') | list %}

  # Podman network {{ network }}: its containers reach each other by name
  systemd.services."podman-network-{{ network }}" = {
    path = [ config.virtualisation.podman.package ];
    script = "podman network exists {{ network }} || podman network create {{ network }}";
    serviceConfig = {
      Type = "oneshot";
      RemainAfterExit = true;
    };
    wantedBy = [ "multi-user.target" ];
    before = [ {% for name in users %}"podman-{{ name }}.service" {% endfor %}];
    requiredBy = [ {% for name in users %}"podman-{{ name }}.service" {% endfor %}];
  };
{% endfor %}
{% if nixos_container_autoupdate | bool %}

  # Pulls newer images daily and restarts the containers that use them
  systemd.timers.podman-auto-update.wantedBy = [ "timers.target" ];
{% endif %}
}
