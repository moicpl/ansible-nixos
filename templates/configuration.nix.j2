{{ ansible_managed | comment }}
{ config, lib, pkgs, ... }:

{
  imports = [
    ./hardware-configuration.nix
    ./containers.nix
  ];

  boot.loader.systemd-boot.enable = true;
  boot.loader.efi.canTouchEfiVariables = true;

  # DHCP on every interface; nothing depends on the address, which can change.
  # The host is reachable by name: DNS from DHCP, and mDNS ({{ nixos_hostname }}.local).
  networking.hostName = "{{ nixos_hostname }}";
  networking.useDHCP = true;
  services.avahi = {
    enable = true;
    nssmdns4 = true;
    openFirewall = true;
    publish = {
      enable = true;
      addresses = true;
    };
  };

  networking.firewall = {
    enable = true;
    allowedTCPPorts = [ {{ nixos_firewall_tcp_ports | map('string') | join(' ') }} ];
    allowedUDPPorts = [ {{ nixos_firewall_udp_ports | map('string') | join(' ') }} ];
  };

  time.timeZone = "{{ nixos_timezone }}";

  # Users are only the ones declared here
  users.mutableUsers = false;
  users.users.root.hashedPasswordFile = "/etc/nixos/secrets/root.hash";
  users.users.{{ nixos_admin_user }} = {
    isNormalUser = true;
    extraGroups = [ "wheel" ];
    openssh.authorizedKeys.keys = [ "{{ nixos_ssh_public_key | trim }}" ];
  };
  security.sudo.wheelNeedsPassword = false;

  services.openssh = {
    enable = true;
    settings = {
      PermitRootLogin = "{{ 'yes' if nixos_ssh_root_password_login | bool else 'prohibit-password' }}";
      PasswordAuthentication = {{ nixos_ssh_root_password_login | bool | lower }};
    };
  };

  # python3 for Ansible
  environment.systemPackages = with pkgs; [
    python3
    vim
    htop
  ];

  zramSwap.enable = true;

  nix.gc = {
    automatic = true;
    dates = "weekly";
    options = "--delete-older-than 30d";
  };

  system.stateVersion = "{{ nixos_state_version }}";
}
